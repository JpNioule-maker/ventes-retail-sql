		summarizeBy: none
		sortByColumn: remise_pct

	partition Ventes = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "ventes_retail"),
				    Donnees = Source{[Schema="public", Item="v_ventes_detail"]}[Data]
				in
				    Donnees

