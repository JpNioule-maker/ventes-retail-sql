table Ventes
	lineageTag: 02e2b4ea-2fa8-f180-2d2b-b66fbdcb7089

	/// Chiffre d'affaires net, après remise.
	measure 'CA net' = SUM ( Ventes[montant_net] )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Indicateurs
		lineageTag: d91ad5e9-e697-1877-a939-47d89e80e568

	/// CA net moins coût d'achat.
	measure 'Marge commerciale' = SUM ( Ventes[marge] )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Indicateurs
		lineageTag: 510881e6-e8dd-ac0f-948c-75df85bb2be8

	/// Marge rapportée au CA net.
	measure 'Taux de marge' = DIVIDE ( [Marge commerciale], [CA net] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Indicateurs
		lineageTag: 88920301-0e05-8793-0dfb-1b14f81b51ae

	/// Une ligne de la vue = une vente.
	measure 'Nombre de ventes' = COUNTROWS ( Ventes )
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: a19c9f20-65a1-0079-d45c-cdc29557fa1a

	/// CA net moyen par vente.
	measure 'Panier moyen' = DIVIDE ( [CA net], [Nombre de ventes] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Indicateurs
		lineageTag: f87cd2dc-2722-96c0-fc36-4beea822c79b

	/// CA net de la même période l'année précédente, à périodes comparables.
	measure 'CA A-1' =
			-- Même période un an plus tôt, limitée aux dates déjà écoulées :
			-- en 2026 (arrêtée au 30/09), on compare à janvier-septembre 2025.
			VAR DerniereVente =
			    CALCULATE ( MAX ( Ventes[date_vente] ), REMOVEFILTERS () )
			VAR Periode =
			    FILTER ( VALUES ( Calendrier[date_jour] ), Calendrier[date_jour] <= DerniereVente )
			RETURN
			    CALCULATE ( [CA net], DATEADD ( Periode, -1, YEAR ) )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Indicateurs
		lineageTag: 00bb5f28-aa22-7613-b92d-18b0630a391b

	/// Évolution du CA net par rapport à la même période l'année précédente.
	measure 'Évolution CA vs A-1' = DIVIDE ( [CA net] - [CA A-1], [CA A-1] )
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Indicateurs
		lineageTag: 83d72d2d-95fa-ff0a-6d7e-96a43f266728

	/// Part des ventes ayant bénéficié d'une remise.
	measure 'Part des ventes remisées' = DIVIDE ( CALCULATE ( [Nombre de ventes], Ventes[remise_pct] > 0 ), [Nombre de ventes] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Indicateurs
		lineageTag: 9e1aae43-38ac-3e2e-30b1-ddfb4aa217a5

